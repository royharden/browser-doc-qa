{
  "name": "browser-doc-qa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts tests/acceptance/*.test.ts",
    "test:browser": "node scripts/validate-browser.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "pdfjs-dist": "6.2.108",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
